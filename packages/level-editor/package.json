{
  "name": "thrust-level-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Web level editor for Thrust (C64)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "vite build && node server/index.ts",
    "game-to-mod": "node scripts/game-to-mod.ts",
    "mod-to-game": "node scripts/mod-to-game.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "c64-ready": "^2.5.0",
    "marked": "^18.0.14"
  }
}
